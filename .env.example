# Copy to .env.local (ignored by Git). Never commit real values.

# Neon pooled connection string (Neon console > Connect > "Pooled connection").
DATABASE_URL=
# At least 32 random characters, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin of the app: http://localhost:3000 locally, the Vercel URL when deployed.
BETTER_AUTH_URL=

# Browser journey tests against a running app and a disposable database only.
TEST_DEMO_EMAIL=
TEST_DEMO_PASSWORD=
TEST_OTHER_EMAIL=
TEST_OTHER_PASSWORD=
